FROM rust:1.88.0-slim-bookworm AS build

WORKDIR /workspace
COPY . .
RUN cargo build --locked --release -p payrail-node

FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 payrail \
    && install -d -o payrail -g payrail /var/lib/payrail
COPY --from=build /workspace/target/release/payrail-node /usr/local/bin/payrail-node

USER payrail
EXPOSE 8080
ENV PAYRAIL_NODE_BIND=0.0.0.0:8080
ENV PAYRAIL_NODE_DATA_DIR=/var/lib/payrail/node
ENV PAYRAIL_NODE_UPSTREAMS=https://devnet.payrail.one
ENTRYPOINT ["/usr/local/bin/payrail-node"]
