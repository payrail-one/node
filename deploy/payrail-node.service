[Unit]
Description=Payrail public replica node
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=simple
Restart=always
RestartSec=5
Environment=PAYRAIL_NODE_UPSTREAMS=https://devnet.payrail.one
EnvironmentFile=-/etc/payrail/node.env
ExecStartPre=-/usr/bin/docker rm -f payrail-node
ExecStart=/usr/bin/docker run --name payrail-node --read-only --cap-drop ALL --security-opt no-new-privileges:true --publish 127.0.0.1:18080:8080 --volume payrail-node-state:/var/lib/payrail --env PAYRAIL_NODE_UPSTREAMS=${PAYRAIL_NODE_UPSTREAMS} payrail/node:latest
ExecStop=/usr/bin/docker stop --time 30 payrail-node
TimeoutStartSec=60
TimeoutStopSec=45

[Install]
WantedBy=multi-user.target
