[Unit]
Description=Payrail public testnet gateway
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=simple
Restart=on-failure
RestartSec=3
ExecStartPre=-/usr/bin/docker rm -f payrail-testnet-gateway
ExecStart=/usr/bin/docker run --name payrail-testnet-gateway --network host --read-only --cap-drop ALL --security-opt no-new-privileges:true --volume /var/lib/payrail-testnet:/var/lib/payment-platform --volume /etc/payrail/validator-seed.bin:/run/secrets/payrail-validator-seed.bin:ro --env-file /etc/payrail/gateway.env payrail/devnet-gateway:candidate
ExecStop=/usr/bin/docker stop --time 15 payrail-testnet-gateway
TimeoutStartSec=60
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
